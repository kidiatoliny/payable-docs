---
import { SidebarClient } from './Sidebar';
import type { NavGroup } from '@/lib/nav';

interface Props {
  nav: NavGroup[];
  currentSlug: string;
}

const { nav, currentSlug } = Astro.props;
---

<aside
  data-docs-sidebar
  class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-72 shrink-0 border-r border-border bg-background lg:block"
>
  <SidebarClient client:only="react" nav={nav} currentSlug={currentSlug} />
</aside>
